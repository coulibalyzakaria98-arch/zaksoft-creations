# ============================================
# ZAKSOFT Créations - Master Environment Template
# ============================================

# --- APP CONFIG ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- DATABASE (Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/zaksoft?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/zaksoft?schema=public"

# --- REDIS (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- AUTHENTICATION ---
JWT_SECRET=your_jwt_secret_change_me
NEXTAUTH_SECRET=your_nextauth_secret_change_me
NEXTAUTH_URL=http://localhost:3000

# --- STRIPE (Payments) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_BASIC_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxx

# --- AI APIs ---
REPLICATE_API_KEY=r8_xxx
RUNWAY_API_KEY=rw_xxx
OPENAI_API_KEY=sk-proj_xxx
ELEVENLABS_API_KEY=xxx

# --- STORAGE (S3/R2) ---
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_BUCKET=zaksoft-assets
S3_REGION=eu-west-3
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com # Required for R2
NEXT_PUBLIC_S3_PUBLIC_URL=https://your-bucket-public-url.com

# --- MONITORING (Sentry) ---
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=zaksoft
SENTRY_PROJECT=zaksoft-web
SENTRY_AUTH_TOKEN=xxx

# --- SERVICE PORTS ---
AUTH_PORT=10000
DESIGN_PORT=3003
VIDEO_PORT=3002
WEB_GEN_PORT=3004
BILLING_PORT=3005
