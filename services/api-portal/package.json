{
  "name": "@zaksoft/api-portal",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "pretype-check": "prisma generate --schema=./prisma/schema.prisma --no-engine",
    "type-check": "prisma generate --schema=./prisma/schema.prisma && tsc --noEmit",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma --no-engine"
  },
  "dependencies": {
    "@prisma/client": "5.11.0",
    "@zaksoft/health": "workspace:^",
    "@zaksoft/logging": "workspace:^",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.4",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.0.2",
    "prisma": "5.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
