{
  "name": "@zaksoft/marketplace",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "pretype-check": "prisma generate",
    "type-check": "prisma generate --schema=./prisma/schema.prisma && tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.11.0",
    "@zaksoft/health": "workspace:^",
    "@zaksoft/logging": "workspace:^",
    "bullmq": "^4.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "nodemon": "^3.0.2",
    "prisma": "5.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
