 model User {
       id                   String   @id @default(cuid())
       email                String   @unique
       passwordHash         String
       firstName            String?
       lastName             String?
       companyName          String?
       companySize          String?
       position             String?
   10   industry             String?
   11   role                 String   @default("user")
   12   tier                 Tier     @default(free)
   13   credits              Int      @default(10)
   14   stripeCustomerId     String?  @unique
   15   stripeSubscriptionId String?
   16   howDidYouHear        String?
   17   website              String?
   18   intendedUse          String?
   19   budget               String?
   20   newsletter           Boolean  @default(false)
   21   createdAt            DateTime @default(now())
   22   updatedAt            DateTime @updatedAt
   23   creditTransactions   CreditTransaction[]
   24 }