{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2015",
    "moduleResolution": "bundler",
    "strict": true,           // ← Recommandé pour plus de sécurité
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,  // ← Évite les erreurs de casse
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@zaksoft/database": ["../../packages/database/src"]
    }
  }
}